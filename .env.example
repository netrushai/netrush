# Copy to .env and fill in. Anything left out uses the demo default (console / mock).

FACILITY_NAME=NetRush
PUBLIC_URL=https://book.example.com
PORT=8000

# Demo mode: demo phone (/demo), web door keypad (/door), login codes on screen. 0 in production.
DEMO_MODE=1
# 1 when behind a proxy/host (Render, Railway, nginx, Caddy) so rate limits see the real client IP
TRUST_PROXY=0

# Staff login (created on first run only — change it before going live)
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=change-this

# Hours and slots
OPEN_HOUR=6
CLOSE_HOUR=23
SLOT_MIN=60
# Per court per hour, INR
PRICE_BADMINTON=1000
PRICE_PADEL=1800
PRICE_PICKLEBALL=500

# Membership bought in the member portal (per month), and the month options offered
ONLINE_MEMBERSHIP_MONTHLY=2000
ONLINE_MEMBERSHIP_MONTHS=1,3,6

# Badminton members have a fixed daily slot: max members per court per slot, and days after a
# membership ends before its slot goes to the next person in line
MEMBER_SLOT_CAPACITY=6
MEMBER_SLOT_GRACE_DAYS=0

# A guest who creates an account gets this % off their next court booking (any sport)
WELCOME_COUPON_PCT=10

# Customer cancellations: 100% refund >= 24h before, 50% >= 6h before, none after
REFUND_FULL_HOURS=24
REFUND_PARTIAL_HOURS=6
REFUND_PARTIAL_PCT=50

# Door code: opens the door from this many minutes before the slot (5–10) until it ends.
# DOOR_CODE_AT_BOOKING=1 sends it with the confirmation (plus a reminder when it becomes valid).
DOOR_CODE_LEAD_MIN=10
DOOR_CODE_AT_BOOKING=1
DOOR_CODE_GRACE_MIN=0

# Membership / academy fee reminders: days before expiry, and the hour they go out
REMINDER_DAYS=7,0
REMINDER_HOUR=10

# ---------- SMS: console | twilio | msg91
SMS_PROVIDER=console
# Twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# MSG91 (India). Each message needs a DLT-approved template → one flow id per message type
MSG91_AUTHKEY=
MSG91_FLOW_DOOR_CODE=
MSG91_FLOW_BOOKING=
MSG91_FLOW_MEMBERSHIP=
MSG91_FLOW_ACADEMY=
MSG91_FLOW_LOGIN=
MSG91_FLOW_CANCELLED=
MSG91_FLOW_REFUND=
MSG91_FLOW_MEMBERSHIP_OK=
MSG91_FLOW_WELCOME_COUPON=

# ---------- WhatsApp: console | meta  (WhatsApp Cloud API; templates must be approved in Meta Business Manager)
WHATSAPP_PROVIDER=console
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_LANG=en
WA_TPL_DOOR_CODE=door_code
WA_TPL_BOOKING=booking_confirmed
WA_TPL_MEMBERSHIP=membership_reminder
WA_TPL_ACADEMY=academy_fee_reminder
WA_TPL_LOGIN=login_otp
WA_TPL_CANCELLED=booking_cancelled
WA_TPL_REFUND=refund_issued
WA_TPL_MEMBERSHIP_OK=membership_confirmed
WA_TPL_WELCOME_COUPON=welcome_coupon

# ---------- Lock: console | http_bridge | ttlock
LOCK_PROVIDER=console
# The door controller signs its calls to /api/lock/* with this (see tools/door_device.py)
DEVICE_SECRET=long-random-string
# http_bridge: an on-site service that talks to a ZKTeco / eSSL / Hikvision controller
LOCK_BRIDGE_URL=
LOCK_BRIDGE_SECRET=
# ttlock: TTLock Open Platform (Wi-Fi fingerprint + keypad locks with a G2 gateway)
TTLOCK_API=https://euapi.ttlock.com
TTLOCK_CLIENT_ID=
TTLOCK_ACCESS_TOKEN=
TTLOCK_LOCK_ID=

# ---------- Payments: mock | razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → event payment.captured, URL <PUBLIC_URL>/api/payments/razorpay-webhook
RAZORPAY_WEBHOOK_SECRET=
